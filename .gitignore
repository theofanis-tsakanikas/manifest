# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv-checkov/

# Terraform
.terraform/
# `.terraform.lock.hcl` IS committed. Provider versions that resolve differently between a
# validation run and a deploy make "validated" mean nothing.
*.tfstate
*.tfstate.*
*.tfplan

# **Variable files are never committed**, and this line was missing until 2026-08-10.
#
# `infra/bootstrap` takes an alert address — which is a person's email, and therefore personal
# data under the retention rules this project applies to everything else — and a Bedrock model
# ARN, which names the account. Neither belongs in a repository, and the failure mode is not a
# dramatic one: somebody writes a `terraform.tfvars` so they do not have to retype four values,
# and it is committed with everything else in the same `git add -A`.
#
# `.auto.tfvars` is listed separately because Terraform loads it without being asked, which is
# exactly why somebody would reach for it.
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
crash.log
override.tf
override.tf.json

# Secrets — never
.env
.env.*
*.pem
*.key
credentials.json
.bootstrap_outputs.json

# Build output — everything under out/ is generated by a command in this repository
out/
build/
dist/

# The rendered corpus. The *generator* and the ground truth are committed; the rasterised
# pages are not — they are large, they are binary, and they are reproducible from a seed by
# `make corpus`. What must be committed is anything a claim is scored against, which is why
# `recordings/` is tracked and this is not.
corpus/rendered/

# macOS
.DS_Store

# Raw screen recordings and their exports. The *storyboard* is committed and the two rendered
# videos in promo/out/ are the deliverable; the Screen Studio project directories behind them are
# hundreds of megabytes of intermediate footage that regenerate from nothing and belong in git
# even less than the rasterised corpus does.
promo/*.screenstudio/
